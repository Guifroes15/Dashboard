# Yamcol Dashboard Environment Variables

VITE_ANTHROPIC_KEY=

# Server-side only (api/kommo.ts) — SEM prefixo VITE_, nunca vai pro navegador.
# JSON: {"<storeId>":{"subdomain":"...","token":"..."}, ...}
KOMMO_ACCOUNTS=

# Server-side only (api/meta.ts) — SEM prefixo VITE_, nunca vai pro navegador.
# Token de sistema do Meta (Marketing API) — antes era VITE_META_ACCESS_TOKEN,
# exposto no bundle público. Trocar VITE_META_ACCESS_TOKEN por META_ACCESS_TOKEN
# na Vercel (mesmo valor, só sem o prefixo VITE_).
META_ACCESS_TOKEN=
